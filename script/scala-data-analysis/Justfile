# Set the shell for Windows, because sh on Windows (e.g. git bash) sucks
set windows-shell := ["powershell.exe", "-c"]

sources := "."

compile platform="jvm":
	scala-cli compile --test --platform {{platform}} {{sources}}

test platform="jvm":
	scala-cli test --platform {{platform}} {{sources}}

test-all: (test "jvm") (test "js") (test "native")

update:
	scala-cli dependency-update --all {{sources}}

clean:
	scala-cli clean {{sources}}
	scala-cli setup-ide {{sources}}

scalafmt:
	scala-cli fmt {{sources}}

scalafix:
	scala-cli fix --scalafix --enable-built-in=false {{sources}}

#---------8<-----------
# non shared part below

run *args:
	scala-cli run {{sources}} -- {{args}}

weekly-plots:
	scala-cli run --main-class whataretheydoing.makeWeeklyPlotSvgs {{sources}}

commit-type:
	scala-cli run --main-class whataretheydoing.makeRq2CommitTypeSvgs {{sources}}

commit-type-per-agent:
	scala-cli run --main-class whataretheydoing.makeRq2CommitTypePerAgentSvgs {{sources}}

lines-changed-boxplots:
	scala-cli run --main-class whataretheydoing.makeRq2LinesChangedBoxplots {{sources}}

lines-changed-weekly-stacked:
	scala-cli run --main-class whataretheydoing.makeRq2LinesChangedWeeklyStackedSvgs {{sources}}

all-rq2:
	scala-cli run --main-class whataretheydoing.makeAllRq2Svgs {{sources}}

tasks-csv:
	scala-cli run --main-class whataretheydoing.exportTasksPerAgent {{sources}}

commit-types-by-agent:
	scala-cli run --main-class whataretheydoing.exportCommitTypesByAgent {{sources}}

commit-types-by-agent-figs:
	scala-cli run --main-class whataretheydoing.makeCommitTypesByAgentSvg {{sources}}

commit-types-by-agent-figs-log:
	scala-cli run --main-class whataretheydoing.makeCommitTypesByAgentSvgLog {{sources}}

commit-types-by-agent-per-developer-figs:
	scala-cli run --main-class whataretheydoing.makeCommitTypesByAgentPerDeveloperSvgs {{sources}}

agents-by-commit-type:
	scala-cli run --main-class whataretheydoing.exportAgentsByCommitType {{sources}}

agents-by-commit-type-figs:
	scala-cli run --main-class whataretheydoing.makeAgentsByCommitTypeSvgs {{sources}}

agents-by-commit-type-colored-tables:
	scala-cli run --main-class whataretheydoing.makeAgentsByCommitTypeColoredTables {{sources}}

agent-signal-rate:
	scala-cli run --main-class whataretheydoing.exportAgentSignalRatePerDeveloper {{sources}}

agent-harness-distribution:
	scala-cli run --main-class whataretheydoing.exportAgentHarnessDistribution {{sources}}

agent-share-weekly:
	scala-cli run --main-class whataretheydoing.makeAgentShareWeeklyPlotSvgs {{sources}}

rq2-pdfs:
	mkdir -p ../../paper/figures/rq2
	for svg in ../../figures/rq2/agent-use/*.svg ../../figures/rq2/commit-types/*.svg ../../figures/rq2/agents-by-commit-type/*.svg ../../figures/rq2/agents-by-commit-type/per-developer/*.svg ../../figures/rq2/lines-changed/*.svg ../../figures/rq2/agent-share/*.svg; do \
	  pdf="../../paper/figures/rq2/$(basename "$svg" .svg).pdf"; \
	  rsvg-convert -f pdf -o "$pdf" "$svg"; \
	done
